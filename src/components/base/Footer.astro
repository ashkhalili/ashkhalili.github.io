  <div class="row py-2 lg:py-0 items-center flex-wrap-reverse">
    <div class="text-center lg:col-6 lg:mb-0 lg:text-left">
      <ul>
        <li class="m-2 inline-block">
          <a href="/terms">&copy; Ashkan Khalili 2026</a>
        </li>
        <li class="m-2 inline-block">
          <a
            href="https://www.sussexpremierhealth.com/consultants/mr-ashkan-khalili/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm hover:underline"
          >
            Sussex Premier Health
          </a>
        </li>
        <li class="m-2 inline-block">
          <a
            href="https://creativecommons.org/licenses/by/4.0/"
